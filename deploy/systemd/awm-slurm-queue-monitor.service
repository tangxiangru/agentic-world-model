[Unit]
Description=AWM receipt-backed Slurm ownership queue monitor
After=network-online.target munge.service
Wants=network-online.target

[Service]
Type=simple
User=robtang_google_com
Group=robtang_google_com
WorkingDirectory=/home/robtang_google_com/gangda_workspace/agentic-world-model
Environment=AWM_SLURM_QUEUE_ROOT=/rmeng_data/robtang/slurm-queue
ExecStart=/home/robtang_google_com/gangda_workspace/agentic-world-model/.venv/bin/python -m awm.slurm_queue monitor-loop --interval 15 --enforce-unknown-after 60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
