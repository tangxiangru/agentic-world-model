{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "awm-wm-benchmark launch record v1",
  "description": "One archived checkpoint's production chain, reconstructed from the scientist's session trace. Every claim cites trace event numbers (seq) from data/timeline/<cell>/events.jsonl.",
  "type": "object",
  "required": [
    "schema",
    "checkpoint_id",
    "cell",
    "archived_from_dir",
    "archive_evidence",
    "steps",
    "environment",
    "confidence",
    "open_issues"
  ],
  "properties": {
    "schema": {
      "const": "awm-wm-launch-record-v1"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "cell": {
      "type": "string"
    },
    "archived_from_dir": {
      "type": [
        "string",
        "null"
      ],
      "description": "workspace directory the recorder archived as this checkpoint (e.g. /home/ben/task/out_sft2)"
    },
    "archive_evidence": {
      "type": "object",
      "required": [
        "archive_submit_seq",
        "how_known"
      ],
      "properties": {
        "closed_submit_seq": {
          "type": [
            "integer",
            "null"
          ],
          "description": "deprecated alias of archive_submit_seq"
        },
        "how_known": {
          "type": "string",
          "description": "which events establish the directory\u2192checkpoint mapping"
        },
        "archive_submit_seq": {
          "type": [
            "integer",
            "null"
          ],
          "description": "the FIRST `awm wm submit` whose result reported `archived` for this card: the recorder copied the directory at that moment and never again. The archived content is the directory state at this seq; edits after it are not in the checkpoint."
        },
        "later_submits_after_archive": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "description": "the production chain in execution order, from the declared base model to archived_from_dir; the last step's output is the archived directory",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "kind",
          "launch",
          "inputs",
          "outputs",
          "files"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "train",
              "data_build",
              "weight_average",
              "select_checkpoint",
              "config_edit",
              "convert",
              "copy",
              "other"
            ]
          },
          "launch": {
            "type": "object",
            "required": [
              "seq",
              "command"
            ],
            "properties": {
              "seq": {
                "type": "integer"
              },
              "ts": {
                "type": "string"
              },
              "command": {
                "type": "string",
                "description": "the full Bash command as issued"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "the process actually launched, split; only the part that produced the output"
              },
              "cwd": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "description": "environment assignments on the command line"
              },
              "background": {
                "type": "boolean"
              },
              "completion_evidence_seq": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "event showing the process finished (log tail, ls of output dir, eval on it)"
              },
              "superseded_attempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer"
                    },
                    "why": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "inputs": {
            "type": "object",
            "required": [
              "parent_model"
            ],
            "properties": {
              "parent_model": {
                "type": "object",
                "required": [
                  "kind",
                  "ref"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "base_model",
                      "workspace_dir",
                      "hf_hub",
                      "unknown"
                    ]
                  },
                  "ref": {
                    "type": "string"
                  },
                  "checkpoint_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "if the workspace dir was archived as a checkpoint in this cell"
                  },
                  "produced_by_step": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "step_id in this record that produced the dir"
                  }
                }
              },
              "data_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "other_inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "additional_parents": {
                "type": "array",
                "description": "further model inputs of a merge/average, same shape as parent_model",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "base_model",
                        "workspace_dir",
                        "hf_hub",
                        "unknown"
                      ]
                    },
                    "ref": {
                      "type": "string"
                    },
                    "checkpoint_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "if the workspace dir was archived as a checkpoint in this cell"
                    },
                    "produced_by_step": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "step_id in this record that produced the dir"
                    }
                  }
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "description": "launch-time content of every workspace file the step reads as code/config",
            "items": {
              "type": "object",
              "required": [
                "path",
                "role",
                "source"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "entrypoint",
                    "helper",
                    "config",
                    "data_builder",
                    "inline_script"
                  ]
                },
                "source": {
                  "type": "string",
                  "description": "fs@seq=N (replayed Write/Edit), heredoc@seq=N (extracted from a Bash command), read@seq=N (recovered from a Read result), inline@seq=N (python -c / heredoc script), unavailable:<reason>"
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "hash of the launch-time content when known"
                },
                "content_file": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "where the content is stored: data/timeline/_files/<sha> or data/benchmark/x_raw/<cell>/files/<name>"
                }
              }
            }
          },
          "observed_in_trace": {
            "type": "object",
            "description": "facts the trace shows about this step (example counts, steps, wall time) \u2014 provenance only, never predictor input"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "container",
        "installs_before_last_launch"
      ],
      "properties": {
        "container": {
          "type": "string"
        },
        "installs_before_last_launch": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer"
              },
              "command": {
                "type": "string"
              }
            }
          }
        },
        "versions_observed": {
          "type": "object"
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_seqs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "base_model_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "description": "if the trace shows it: the HF snapshot revision / path of the declared base model the scientist loaded",
      "properties": {
        "repo": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}