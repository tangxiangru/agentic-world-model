#!/bin/bash

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

case "${1:-current}" in
    current)
        [ "$#" -gt 0 ] && shift
        exec "$REPO_ROOT/.venv/bin/awm" slurm queue "$@"
        ;;
    failures|history|show)
        view="$1"
        shift
        exec "$REPO_ROOT/.venv/bin/awm" slurm "$view" "$@"
        ;;
    *)
        exec "$REPO_ROOT/.venv/bin/awm" slurm queue "$@"
        ;;
esac
