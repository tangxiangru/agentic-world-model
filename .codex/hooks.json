{
  "description": "Surface a ready exp_protocol completion-monitor event when this goal resumes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/tools/exp_protocol_monitor_event.py\"",
            "statusMessage": "Checking the exp_protocol completion monitor",
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
